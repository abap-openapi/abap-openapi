        "properties": {
          "name": { "type": "string" }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "note": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "count": {
            "anyOf": [{ "type": "integer" }, { "type": "null" }]
          },
          "owner": {
            "anyOf": [{ "$ref": "#/components/schemas/Owner" }, { "type": "null" }]
          }
        }
      }
    }
